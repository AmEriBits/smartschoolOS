generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SchoolApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SchoolStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum SchoolMembershipRole {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolMembershipStatus {
  INVITE_PENDING
  INVITE_SENDING
  INVITED
  ACTIVE
  INVITE_FAILED
  SUSPENDED
}

model SchoolApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolName         String
  location           String
  schoolType         String
  contactEmail       String
  administratorEmail String
  applicantAuthId    String                  @db.Uuid
  status             SchoolApplicationStatus @default(PENDING_REVIEW)
  reviewedAt         DateTime?
  reviewedByAuthId   String?                 @db.Uuid
  rejectionReason    String?
  schoolId           String?                 @unique @db.Uuid
  school              School?                 @relation(fields: [schoolId], references: [id])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([applicantAuthId, status])
}

model School {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  schoolCode        String             @unique
  location          String
  schoolType        String
  status            SchoolStatus       @default(ONBOARDING)
  discoverable      Boolean            @default(false)
  application       SchoolApplication?
  memberships       SchoolMembership[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, discoverable, name])
}

model SchoolMembership {
  id          String                 @id @default(uuid()) @db.Uuid
  schoolId    String                 @db.Uuid
  authUserId  String?                @db.Uuid
  email       String
  role        SchoolMembershipRole
  status      SchoolMembershipStatus @default(INVITE_PENDING)
  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  acceptedAt  DateTime?
  updatedAt   DateTime               @updatedAt

  @@unique([schoolId, email, role])
  @@unique([schoolId, authUserId, role])
  @@index([authUserId, status])
}

model PlatformOperator {
  id          String   @id @default(uuid()) @db.Uuid
  authUserId  String   @unique @db.Uuid
  email       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorAuthId  String?  @db.Uuid
  actorEmail   String?
  action       String
  entityType   String
  entityId     String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorAuthId, createdAt])
}
