{
  "name": "@smartschools/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:seed-operator": "node --env-file=../../.env prisma/seed-operator.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.15.30",
    "prisma": "^6.19.3",
    "typescript": "^5.8.3"
  }
}
